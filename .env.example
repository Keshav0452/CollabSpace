# Copy this file to .env and replace the secrets before starting Docker Compose.
DB_NAME=collabspace
DB_USER=collabspace_app
DB_PASSWORD=replace-with-a-long-random-database-password
JWT_SECRET=replace-with-at-least-32-random-characters
APP_PORT=8080

# Number of reverse proxies in front of the backend (affects rate limiting by IP).
# 1 = only the bundled nginx. 2 = an HTTPS proxy or CDN in front of nginx.
TRUST_PROXY=1

# Optional: how long a login lasts without activity (hours). Active users are renewed automatically.
ACCESS_TOKEN_TTL_HOURS=24
